# =============================================================================
# Docker Ignore - IdaraOS
# =============================================================================
# Exclude files not needed in Docker build context to speed up builds
# =============================================================================

# Dependencies (will be installed fresh in container)
node_modules
**/node_modules

# Build outputs
.next
**/.next
out
**/out
dist
**/dist
build
**/build

# Development files
*.local
.env
.env.*
!.env.example

# Git
.git
.gitignore

# IDE
.idea
.vscode
*.swp
*.swo
.cursor

# Testing
coverage
**/coverage
.vitest
test-results
playwright-report

# Documentation (not needed in runtime)
docs
*.md
!README.md

# Misc
*.log
npm-debug.log*
pnpm-debug.log*
.DS_Store
Thumbs.db

# Deployment configs (not needed in image, except scripts)
deployment/**
!deployment/docker/init-db.sh
!deployment/docker/start-dev.sh
# Served to agent devices for self-update and read by the app at build/runtime
!deployment/agent/IdaraOS-Agent.ps1
# Served for self-install (installer) and web-filtering category lists (/api/updater/v1/...)
!deployment/agent/Install-IdaraOSAgent.ps1
!deployment/agent/filter-lists
!deployment/agent/filter-lists/*.txt
# Served for the self-hosted Vault browser extension (/api/updater/v1/extension/...)
!deployment/extension
!deployment/extension/*.crx
.github

# Specs and scripts (development only)
specs
scripts/generate

# Storybook
storybook-static
